# Необязательные настройки. Скопируй в .env, раскомментируй нужное и выполни source .env.
#
# Linux добавляет radio-wave к каждому пути XDG.
# export XDG_DATA_HOME="$HOME/.local/share"
# export XDG_STATE_HOME="$HOME/.local/state"
# export XDG_CACHE_HOME="$HOME/.cache"
#
# Android. Подставь пути к установленным Android SDK и JDK 17.
# export ANDROID_HOME="$HOME/Android/Sdk"
# export JAVA_HOME="/path/to/jdk-17"
